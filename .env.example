# Copy to .env for local development. Never commit real credentials.
APP_ENV=development
LEAGUE_ID=917761
# Omit DATABASE_URL to use var/prffs.db locally.
# DATABASE_URL=postgresql+psycopg://user:password@host:25060/prffs?sslmode=require
ESPN_S2=
ESPN_SWID=
# Generate with: python3 -c 'import secrets; print(secrets.token_urlsafe(32))'
ADMIN_TOKEN=
INITIALIZE_DATABASE_ON_STARTUP=true
# Production uses same-origin routing. Only set CORS_ORIGINS for separate origins.
# CORS_ORIGINS=["https://your-frontend.example"]
